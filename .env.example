# ─────────────────────────────────────────────────────────────
# Scout — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase — server side (service role bypasses RLS; agent/admin writes only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-keep-secret

# Supabase — client + SSR auth (safe to expose; gated by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-public-key

# Anthropic Claude — used by the n8n reranker/drafter; lib/anthropic.ts is a sync helper
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to a current Claude model in lib/anthropic.ts)
ANTHROPIC_MODEL=

# n8n — webhook fired by POST /api/jobs to kick the new-job-shortlist workflow
N8N_WEBHOOK_URL_NEW_JOB=https://YOUR-N8N-HOST/webhook/new-job-shortlist
# Optional shared secret sent as x-scout-signature header (validate in the n8n webhook)
N8N_WEBHOOK_SECRET=
